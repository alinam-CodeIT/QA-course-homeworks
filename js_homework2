/* 2
Є числова оцінка від 0 до 100. Використовуючи switch(true) та умови в case, виведіть літерну оцінку:
90–100 → "A"
70–89 → "B"
50–69 → "C"
0–49 → "F"
 */

function task2() {
    console.log("Task 2");

    let score = Number(prompt("Enter the Score to find the Grade: "));

    switch (true) {
    case (score >= 0 && score <= 49):
        console.log('Grade F');
        break;
    case (score >= 50 && score <= 69):
        console.log('Grade C');
        break;
    case (score >= 70 && score <= 89):
        console.log('Grade B');
        break;
    case (score >= 90 && score <= 100):
        console.log('Grade A');
        break;
    default:
        console.log('Incorrect Score value');
    }
}



/* 3
Створіть змінну month з числом від 1 до 12. Використовуючи switch з групуванням (без break між певними case), виведіть назву сезону:
12, 1, 2 → "Зима"
3, 4, 5 → "Весна"
6, 7, 8 → "Літо"
9, 10, 11 → "Осінь"
Якщо число не від 1 до 12, виведіть "Невірний місяць".
 */

function task3 () {
    console.log("Task 3");

    let month = Number(prompt("Enter the Month's number to find the Season: "));

    switch (month) {
        case 12:
        case 1:
        case 2:
            console.log("Winter");
            break;

        case 3:
        case 4:
        case 5:
            console.log("Spring");
            break;

        case 6:
        case 7:
        case 8:
            console.log("Summer");
            break;

        case 9:
        case 10:
        case 11:
            console.log("Autumn");
            break;

        default:
            console.log("Incorrect Month value");
    }
}


/* 4
Використовуючи цикл for, виведіть числа від 1 до 30. Але:
Якщо число ділиться на 3 — виведіть "Fizz"
Якщо ділиться на 5 — виведіть "Buzz"
Якщо ділиться і на 3, і на 5 — виведіть "FizzBuzz"
Інакше — виведіть саме число
 */

function task4 () {
    console.log("Task 4");

    for (let number = 1; number <= 30; number++){
        if (number % 3 === 0 && number % 5 === 0){
            console.log("FizzBuzz");
        } else if (number % 3 === 0){
            console.log("Fizz");
        } else if (number % 5 === 0){
            console.log("Buzz");
        } else {
            console.log(number);
        }
    }
}


/* 5
Дано число n (наприклад, 91). За допомогою циклу while 
знайдіть його найменший дільник більший за 1. 
Використайте break для виходу з циклу, як тільки дільник знайдено.
 */

function task5() {
    console.log("Task 5");

    let dividedNumber = Number(prompt("Enter the Number to find its least divisor: "));

    if (!dividedNumber){
        console.log("Invalid input");
    } else { if (dividedNumber === 1){
        console.log("1 has no divisors greater than 1");
        }
    }

    let divisor = 2;

    while (divisor <= dividedNumber){

        if (dividedNumber % divisor === 0){
            console.log("Least divisor of the ", dividedNumber, " is ", divisor);
            break;
        } else {
            divisor++;
        }
    }
}


