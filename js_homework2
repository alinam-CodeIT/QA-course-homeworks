/* 1
Напишіть програму, яка отримує вік користувача (збережіть у змінну) та виводить у консоль:
"Дитина" — якщо вік менше 12
"Підліток" — від 12 до 17 включно
"Дорослий" — від 18 до 64 включно
"Пенсіонер" — 65 і більше
Використайте if / else if / else.
 */

function task1() {
    console.log("Task 1");

    let age = Number(prompt("Enter the Age of user: "));

    if(Number.isFinite(age)){
        if (age < 12){
        console.log("Child")
    } else if (age >= 12 && age <= 17){
        console.log("Teenager")
    } else if (age >= 18 && age <= 64){
        console.log("Adult")
    } else {
        console.log("Senior")
    }
    } else console.log("Invalid age value.")

    
}

